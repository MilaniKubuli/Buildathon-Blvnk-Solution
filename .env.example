# Groq Qwen AI API Key & Model
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen-2.5-32b

# Neon PostgreSQL Database Connection
NEON_CONNECTION_STRING=your_neon_connection_string_here

# Google Cloud Translate API Key
CLOUD_TRANSLATE_API_KEY=your_cloud_translate_api_key_here

# Hugging Face API Token & NLLB-200 Model Engine
HF_API_TOKEN=your_hf_api_token_here
NLLB_MODEL=facebook/nllb-200-distilled-600M

# Supabase Credentials (optional fallback)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
