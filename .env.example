# ThumaFix SA environment template
# Copy to .env.local for local development. Leave values blank until configured.
# Never commit .env.local or paste real passwords, SA ID numbers or secret keys here.

# Browser-visible configuration. These values are embedded in a static build.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Slug of an approved active municipality row, after authoritative import.
NEXT_PUBLIC_MUNICIPALITY_SLUG=

# Development-only interface preview. Keep false for any shared/production build.
NEXT_PUBLIC_ENABLE_LOCAL_PREVIEW=false

# Server/Edge Function only: Groq structured complaint analysis.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_API_ENDPOINT=

# Server/Edge Function only: privileged Supabase operations.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated exact origins accepted by Edge Functions.
ALLOWED_ORIGINS=http://localhost:3000

# Server/Edge Function only: transactional email through Resend.
RESEND_API_KEY=
RESEND_FROM=
RESEND_API_ENDPOINT=

# Server/Edge Function only: transactional SMS through Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Server-to-server delivery endpoint for persisted in-app notifications.
IN_APP_NOTIFICATION_ENDPOINT=
IN_APP_NOTIFICATION_BEARER_TOKEN=

# Server-to-server atomic rate limiter for production write operations.
RATE_LIMIT_ENDPOINT=
RATE_LIMIT_BEARER_TOKEN=
